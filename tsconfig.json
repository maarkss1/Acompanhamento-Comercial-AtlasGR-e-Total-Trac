{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "none",
    "moduleDetection": "legacy",
    "rootDir": "ts",
    "outDir": "js",
    "strict": false,
    "noEmitOnError": true,
    "removeComments": false,
    "newLine": "lf",
    "skipLibCheck": true
  },
  "include": ["ts/**/*.ts"]
}
